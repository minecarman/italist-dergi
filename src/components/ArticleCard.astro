---
import type { CollectionEntry } from 'astro:content';

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props as Props;
const labels: Record<CollectionEntry<'blog'>['data']['category'], string> = {
  edebiyat: 'Edebiyat',
  tarih: 'Tarih',
  dil: 'Dil',
  kultur: 'Kültür'
};
---
<article class="group"><a href={`/yazilar/${post.slug}`}><div class="aspect-[4/3] overflow-hidden rounded-sm bg-stone-200"><img src={post.data.heroImage} alt="" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" /></div><div class="mt-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-terracotta"><span>{labels[post.data.category]}</span><span class="text-stone-300">/</span><span class="text-stone-500">{post.data.readingTime} dk</span></div><h3 class="serif mt-2 text-xl leading-tight group-hover:text-terracotta">{post.data.title}</h3><p class="mt-2 line-clamp-2 text-sm leading-6 text-stone-600">{post.data.description}</p></a></article>
