---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
const { title = 'İtalist — İtalyan kültürüne açılan bir sayfa', description = 'Üniversite öğrencilerinin İtalyan dili, tarihi ve kültürü üzerine dergisi.' } = Astro.props;
---
<!doctype html><html lang="tr"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title></head>
<body class="grain"><Navbar /><main><slot /></main><Footer /></body></html>
