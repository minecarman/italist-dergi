---
import { getCollection } from 'astro:content'; import Layout from '../../layouts/Layout.astro'; import { ArrowLeft, Download, ExternalLink } from 'lucide-astro';
export async function getStaticPaths(){ return (await getCollection('issues')).map(issue=>({params:{id:issue.id},props:{issue}})); }
const {issue}=Astro.props;
---
<Layout title={`${issue.data.title} — İtalist`}><section class="mx-auto max-w-6xl px-5 py-14 lg:px-8"><a href="/sayilar" class="inline-flex items-center gap-2 text-sm text-stone-500 hover:text-terracotta"><ArrowLeft size={16}/> Arşive dön</a><div class="mt-10 grid gap-12 lg:grid-cols-[280px_1fr]"><img src={issue.data.coverImage} alt={issue.data.title} class="w-full rounded-sm shadow-cover" /><div><p class="text-xs font-bold uppercase tracking-[.25em] text-terracotta">İtalist · Sayı {issue.data.issueNumber}</p><h1 class="serif mt-3 text-5xl">{issue.data.title}</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">{issue.data.summary}</p><div class="mt-8 flex flex-wrap gap-3">{issue.data.pdfUrl && <a href={issue.data.pdfUrl} download class="inline-flex items-center gap-2 rounded-full bg-terracotta px-5 py-3 text-sm font-semibold text-white"><Download size={16}/> PDF indir</a>}{issue.data.embedUrl && <a href={issue.data.embedUrl} target="_blank" class="inline-flex items-center gap-2 rounded-full border border-stone-300 px-5 py-3 text-sm font-semibold"><ExternalLink size={16}/> Online reader</a>}</div><div class="mt-12 overflow-hidden rounded-lg border border-stone-200 bg-white"><iframe title="Dergi okuyucu" src={issue.data.embedUrl ?? issue.data.pdfUrl} class="h-[620px] w-full" /></div></div></div></section></Layout>
